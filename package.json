{
  "name": "classroom-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && node scripts/check-deploy.mjs && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev:secured": "node scripts/dev.mjs --secured",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/qrcode": "1.5.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
